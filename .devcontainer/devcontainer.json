{
  "name": "treedom — Laboratório DOM",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Laboratório DOM",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.tabSize": 2,
        "files.eol": "\n"
      }
    }
  },
  "postCreateCommand": "node --check exercicios.js"
}
